# Password for the whole app. Leave unset locally; always set it when hosted.
# The browser prompts for it; any username works.
APP_PASSWORD=

# Where clips, outputs, and the yt-dlp binary are written.
# On a server, point this at persistent storage, e.g. /opt/focusvid-data
DATA_DIR=

# Bind address and port. Behind a reverse proxy use HOST=127.0.0.1 so the app
# is not reachable except through the proxy. HOST defaults to 0.0.0.0.
# HOST=127.0.0.1
# PORT=8787

# Use a system ffmpeg instead of the older one bundled through npm.
# FFMPEG_PATH=/usr/bin/ffmpeg

# Font file for burned-in captions. Detected automatically on Windows and on
# Linux with fonts-dejavu-core installed; set it only if captions fail to render.
# FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
